---
interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  position?: string;
  eager?: boolean;
}

const {
  src,
  alt,
  class: className,
  sizes = '(max-width: 760px) 100vw, 50vw',
  position = 'center',
  eager = false,
} = Astro.props;
---

<picture class={className}>
  <source
    type="image/webp"
    srcset={`${src}-sm.webp 720w, ${src}-lg.webp 1920w`}
    {sizes}
  />
  <img
    src={`${src}-lg.webp`}
    {alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    style={`object-position: ${position}`}
  />
</picture>

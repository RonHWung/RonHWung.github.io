---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, description, href, linkLabel = '继续看看' } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2><span>{title}</span></h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {href && <a class="text-link" href={href}>{linkLabel}<span aria-hidden="true">↗</span></a>}
</div>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import FriendCard from '../components/FriendCard.astro';
import { friends } from '../data/friends';
---

<BaseLayout title="友链" description="茸磺在创作、兽装与生活里认识的朋友们。">
  <header class="page-intro friends-intro">
    <div>
      <p class="eyebrow">LINK DIRECTORY // {String(friends.length).padStart(3, '0')}</p>
      <h1>友链</h1>
      <p>从创作、兽装与生活里认识的同行者。点击卡片，可以去往他们各自留下作品和故事的地方。</p>
    </div>
    <aside class="page-intro__note">
      <p class="eyebrow">REMOTE SIGNAL</p>
      <p>头像与签名取自朋友们公开的个人主页；公开资料更新时，以对方页面为准。</p>
      <p class="friends-contact-note">如需修改、增删友链，欢迎提交 Pull Request、Issue，或通过其他方式联系我。</p>
    </aside>
  </header>

  <section class="page-section friends-section" aria-labelledby="friends-heading">
    <header class="friends-heading">
      <p class="eyebrow">AUTHORIZED LINKS</p>
      <h2 id="friends-heading">朋友们的站点与主页</h2>
    </header>
    <div class="friends-grid">
      {friends.map((friend, index) => <FriendCard {friend} {index} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .friends-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(310px, .7fr);
    align-items: center;
    gap: clamp(48px, 8vw, 110px);
  }

  .friends-intro > *,
  .friends-grid {
    min-width: 0;
    max-width: 100%;
  }

  .friends-intro h1 {
    margin-bottom: 24px;
    font-size: clamp(4.8rem, 11vw, 9rem);
  }

  .friends-intro > div > p:last-child {
    max-width: 720px;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .friends-contact-note {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(17, 27, 27, .14);
    font-size: .9rem;
    line-height: 1.75;
  }

  .friends-section {
    padding: 80px 0 110px;
    border-top: 1px solid var(--line);
  }

  .friends-heading {
    margin-bottom: 38px;
  }

  .friends-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 900;
    letter-spacing: .01em;
  }

  .friends-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  @media (max-width: 1000px) {
    .friends-intro {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .friends-intro .page-intro__note {
      width: 100%;
      max-width: 620px;
    }

    .friends-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .friends-intro h1 {
      font-size: clamp(4.2rem, 24vw, 7rem);
    }

    .friends-section {
      padding: 58px 0 82px;
    }

    .friends-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

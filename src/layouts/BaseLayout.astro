---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = site.description,
  image = '/media/art/01-code-bloom-lg.webp',
} = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f8f4e8" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site-effects" aria-hidden="true">
      <span class="site-effects__grid"></span>
      <span class="site-effects__beam"></span>
      <span class="site-effects__reticle"><i></i></span>
      <span class="site-effects__progress"></span>
    </div>
    <div class="page-shell">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      document.documentElement.classList.add('has-js');

      const root = document.documentElement;
      const header = document.querySelector<HTMLElement>('.site-header');
      const reticle = document.querySelector<HTMLElement>('.site-effects__reticle');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const finePointer = window.matchMedia('(pointer: fine)');

      const updateScrollState = () => {
        const scrollRange = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollRange > 0 ? window.scrollY / scrollRange : 0;
        root.style.setProperty('--scroll-progress', `${Math.min(1, Math.max(0, progress))}`);
        header?.classList.toggle('is-scrolled', window.scrollY > 12);
      };

      let pointerFrame = 0;
      window.addEventListener('pointermove', (event) => {
        if (!finePointer.matches || reducedMotion.matches) return;
        root.classList.add('has-pointer');
        if (pointerFrame) cancelAnimationFrame(pointerFrame);
        pointerFrame = requestAnimationFrame(() => {
          const x = event.clientX;
          const y = event.clientY;
          root.style.setProperty('--pointer-x', `${x}px`);
          root.style.setProperty('--pointer-y', `${y}px`);
          root.style.setProperty('--parallax-x', `${(x / window.innerWidth - 0.5) * 14}px`);
          root.style.setProperty('--parallax-y', `${(y / window.innerHeight - 0.5) * 10}px`);
          if (reticle) reticle.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        });
      }, { passive: true });

      const interactive = document.querySelectorAll<HTMLElement>('[data-interactive], .moment-card, .artwork-card, .timeline-card');
      interactive.forEach((panel) => {
        panel.classList.add('interactive-panel');
        panel.addEventListener('pointermove', (event) => {
          if (!finePointer.matches || reducedMotion.matches) return;
          const rect = panel.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          panel.style.setProperty('--panel-x', `${x * 100}%`);
          panel.style.setProperty('--panel-y', `${y * 100}%`);
          panel.style.setProperty('--panel-rx', `${(0.5 - y) * 2.4}deg`);
          panel.style.setProperty('--panel-ry', `${(x - 0.5) * 2.4}deg`);
        });
        panel.addEventListener('pointerleave', () => {
          panel.style.removeProperty('--panel-rx');
          panel.style.removeProperty('--panel-ry');
        });
      });

      const revealTargets = document.querySelectorAll<HTMLElement>('.home-section, .page-section, .collection-block, .character-sheet, .timeline-wrap, .detail-layout, .photo-gallery');
      if (!reducedMotion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        revealTargets.forEach((target) => {
          target.classList.add('reveal-ready');
          const rect = target.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.96 && rect.bottom > 0) {
            target.classList.add('is-revealed');
          } else {
            observer.observe(target);
          }
        });
      }

      const revealHashTarget = () => {
        const hashTarget = window.location.hash ? document.querySelector<HTMLElement>(window.location.hash) : null;
        hashTarget?.classList.add('is-revealed');
      };
      revealHashTarget();
      window.addEventListener('hashchange', revealHashTarget);

      const activeNav = document.querySelector<HTMLElement>('.site-header nav [aria-current="page"]');
      const nav = activeNav?.parentElement;
      if (activeNav && nav && nav.scrollWidth > nav.clientWidth) {
        nav.scrollLeft = activeNav.offsetLeft - (nav.clientWidth - activeNav.offsetWidth) / 2;
      }

      document.addEventListener('pointerover', (event) => {
        const target = event.target as HTMLElement;
        root.classList.toggle('is-action-hovered', Boolean(target.closest('a, button')));
      });
      document.addEventListener('pointerout', (event) => {
        const target = event.relatedTarget;
        if (!(target instanceof HTMLElement) || !target.closest('a, button')) {
          root.classList.remove('is-action-hovered');
        }
      });

      updateScrollState();
      window.addEventListener('scroll', updateScrollState, { passive: true });
    </script>
  </body>
</html>
